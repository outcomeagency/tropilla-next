# Base de la API de TROPILLA (tropilla-api), sólo server-side.
TROPILLA_API_URL=http://localhost:8090/api/v1

# Datos de ejemplo (lib/mock/*) cuando un endpoint todavía no existe o la API no responde.
# 1 = encendido, 0 = apagado. Default: encendido fuera de producción.
TROPILLA_MOCK_FALLBACK=1

# URL pública canónica (sitemap, OpenGraph, QR de ofertas).
NEXT_PUBLIC_SITE_URL=https://tropilla.ar

# Cloudflare Turnstile para el contacto sin cuenta (TPA-55). Sin clave, el widget no se muestra
# y la API decide (en desarrollo acepta el token «sin-turnstile»).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
